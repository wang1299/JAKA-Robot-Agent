# Copy to configs/server.local.env on the GPU server. Environment variables win.
JAKA_MODEL_HOME=$HOME/jaka-models
JAKA_TRANSFORMERS_SPEC=transformers[serving]==5.12.1
# Choose the PyTorch index for your driver, following pytorch.org instructions.
# JAKA_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
JAKA_MINICPM_GPU=0
JAKA_QWEN_GPU=1
JAKA_MINICPM_PORT=8000
JAKA_QWEN_PORT=8001
JAKA_MODEL_DTYPE=bfloat16
# Optional absolute weight/environment directory overrides:
# JAKA_MINICPM_MODEL=/path/to/MiniCPM-V-4.6
# JAKA_QWEN_MODEL=/path/to/Qwen3.5-9B
# JAKA_MINICPM_ENV=/path/to/minicpm-venv
# JAKA_QWEN_ENV=/path/to/qwen-venv
