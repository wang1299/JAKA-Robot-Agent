# Copy to configs/tunnel.local.env. Keep actual SSH details in ~/.ssh/config.
JAKA_SSH_HOST=jaka-model-server
# Optional overrides, normally supplied by the SSH alias:
# JAKA_SSH_USER=your-user
# JAKA_SSH_PORT=22
# JAKA_SSH_IDENTITY=$HOME/.ssh/id_ed25519
JAKA_VISION_LOCAL_PORT=8000
JAKA_VISION_REMOTE_PORT=8000
JAKA_AGENT_LOCAL_PORT=8001
JAKA_AGENT_REMOTE_PORT=8001
